KB_PATH=./knowledge

# OpenAI 兼容 API（必填）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 小模型：录入理解、文档归置
SMALL_MODEL=gpt-4o-mini

# 大模型：提问时整合回答
BIG_MODEL=gpt-4o

# 向量检索 embedding
EMBED_MODEL=text-embedding-3-small

# 可选：大/小/向量 分别使用不同网关或密钥（留空则回退到 OPENAI_*）
# SMALL_BASE_URL=
# SMALL_API_KEY=
# BIG_BASE_URL=
# BIG_API_KEY=
# EMBED_BASE_URL=
# EMBED_API_KEY=

# Agent
AGENT_MAX_TOOL_CALLS=8
AGENT_PARALLEL_TOOLS=true
AGENT_MAX_PARALLEL=4
FETCH_URL_TIMEOUT=15
FETCH_URL_MAX_BYTES=102400

# Web search（配哪个用哪个）
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_PROVIDER_ORDER=tavily,serper,brave

# --- Sub2API 示例 ---
# OPENAI_BASE_URL=http://your-gateway:8080/v1
# SMALL_MODEL=deepseek-v4-flash
# BIG_MODEL=deepseek-v4-pro
