KB_PATH=./knowledge

# 模型与 API Key 请在网页「设置 → 模型」自行添加
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# SMALL_MODEL=
# BIG_MODEL=
# EMBED_MODEL=

# 可选：大/小/向量 分别使用不同网关或密钥
# SMALL_BASE_URL=
# SMALL_API_KEY=
# BIG_BASE_URL=
# BIG_API_KEY=
# EMBED_BASE_URL=
# EMBED_API_KEY=

# Agent
AGENT_MAX_TOOL_CALLS=25
AGENT_PARALLEL_TOOLS=true
AGENT_MAX_PARALLEL=4
FETCH_URL_TIMEOUT=15
FETCH_URL_MAX_BYTES=1048576
FETCH_URL_PDF_MAX_BYTES=20971520


# 向量检索余弦相似度下限
MIN_VECTOR_SCORE=0.45

# Web search（配哪个用哪个）
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARCH_PROVIDER_ORDER=tavily,serper,brave

# edit_doc 局部编辑
EDIT_DOC_MAX_EDITS=10
EDIT_DOC_MAX_PATCH_CHARS=8192
EDIT_DOC_REQUIRE_READ=true
REINDEX_FULL_THRESHOLD=4000

# --- Sub2API 示例 ---
# OPENAI_BASE_URL=http://your-gateway:8080/v1
# SMALL_MODEL=deepseek-v4-flash
# BIG_MODEL=deepseek-v4-pro
