# Python virtual environments
.venv/
**/.venv/
backend/.venv/

.superpowers/

# Local runtime data (private knowledge base — do not commit)
backend/knowledge/
# Entire tree: runtime KB is often its own git repo (nested .git)
docker/data/knowledge/
docker/data/backups/*
!docker/data/backups/.gitkeep
deploy/data/knowledge/
deploy/data/backups/*
!deploy/data/backups/.gitkeep
deploy/.lorechat/
**/.pytest_cache/
__pycache__/
*.pyc
*.pyo

# Secrets and local env (keep *.example tracked)
.env
**/.env
.env.local
.env.*.local
*.pem
id_rsa
id_rsa.pub

# Frontend
frontend/node_modules/
frontend/dist/
*.local

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Runtime / local control
.lorechat/

# Materialized by deploy single-file launchers (do not commit)
/deploy/docker-compose.yml
/deploy/docker-compose.sandbox.yml
/deploy/.env.example
/deploy/opensandbox/

# Git worktrees
.worktrees/
