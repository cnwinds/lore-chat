# 复制为项目根目录 .env 后供 docker compose 使用（-f docker/docker-compose.yml）
# copy .env.docker.example .env

# Web 对外端口
WEB_PORT=8080

# OpenAI 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
SMALL_MODEL=gpt-4o-mini
BIG_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# 可选：为不同档位单独配置
# SMALL_BASE_URL=
# SMALL_API_KEY=
# BIG_BASE_URL=
# BIG_API_KEY=
# EMBED_BASE_URL=
# EMBED_API_KEY=
