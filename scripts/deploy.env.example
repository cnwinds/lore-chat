# 由单文件启动器写出。模型与 API Key 请在网页「设置 → 模型」自行添加。

WEB_PORT=8080

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# SMALL_MODEL=
# BIG_MODEL=
# EMBED_MODEL=

# GHCR 镜像标签：latest（默认）或发行版如 v0.1.0（与 git tag 相同）
LORECHAT_IMAGE_TAG=latest

# 需要换完整镜像名时再取消注释
